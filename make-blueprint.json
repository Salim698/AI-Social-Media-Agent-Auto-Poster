{
    "name": "Integration Webhooks, Facebook Pages",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": 0,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": -194,
                    "y": 25
                },
                "restore": {
                    "parameters": {
                        "hook": {
                            "data": {
                                "editable": "true"
                            },
                            "label": "Instant_FB"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "hook",
                        "type": "hook:gateway-webhook",
                        "label": "Webhook",
                        "required": true
                    },
                    {
                        "name": "maxResults",
                        "type": "number",
                        "label": "Maximum number of results"
                    }
                ],
                "interface": [
                    {
                        "name": "image_url",
                        "type": "text"
                    }
                ]
            }
        },
        {
            "id": 3,
            "module": "facebook-pages:CreatePost",
            "version": 6,
            "parameters": {
                "__IMTCONN__": 0
            },
            "filter": {
                "name": "",
                "conditions": [
                    [
                        {
                            "a": "{{1.image_url}}",
                            "o": "notexist"
                        }
                    ]
                ]
            },
            "mapper": {
                "message": "{{1.post}}",
                "page_id": "YOUR_FB_PAGE_ID"
            },
            "metadata": {
                "designer": {
                    "x": 406,
                    "y": -125
                },
                "restore": {
                    "expect": {
                        "page_id": {
                            "mode": "chose",
                            "label": "YOUR_PAGE_NAME"
                        }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "facebook"
                            },
                            "label": "VOTRE_CONNEXION_FB"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTCONN__",
                        "type": "account:facebook",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "page_id",
                        "type": "select",
                        "label": "Page",
                        "required": true
                    },
                    {
                        "name": "message",
                        "type": "text",
                        "label": "Post caption"
                    },
                    {
                        "name": "link",
                        "type": "url",
                        "label": "Link"
                    },
                    {
                        "name": "name",
                        "type": "text",
                        "label": "Link name"
                    },
                    {
                        "name": "description",
                        "type": "text",
                        "label": "Link description"
                    },
                    {
                        "name": "date",
                        "type": "date",
                        "label": "Publish date"
                    }
                ]
            }
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "eu1.make.com",
        "notes": []
    }
}
